@{
    ViewData["Title"] = "Programme Coordinator Dashboard";
    var pendingClaims = ViewBag.PendingClaims as List<The_CMCS.Models.Claim> ?? new List<The_CMCS.Models.Claim>();
    var allClaims = ViewBag.AllClaims as List<The_CMCS.Models.Claim> ?? new List<The_CMCS.Models.Claim>();
    var pendingManagerReviewCount = ViewBag.PendingManagerReviewCount ?? 0;
}

<div class="dashboard-header">
    <div class="header-content">
        <div class="welcome-section">
            <h1>Programme Coordinator Dashboard</h1>
            <p class="text-muted">Manage and review lecturer claims</p>
            <small class="text-info">Department: @ViewBag.CurrentUserDepartment</small>
        </div>
        <span class="badge bg-info role-badge">Coordinator</span>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card review">
        <div class="stat-icon">
            <i class="fas fa-tasks"></i>
        </div>
        <div class="stat-content">
            <h3>@(ViewBag.PendingReviewCount ?? 0)</h3>
            <p>PENDING REVIEW</p>
            <small class="text-muted">Awaiting your approval</small>
            <div class="stat-progress">
                <div class="progress-bar" style="width: @(allClaims.Count > 0 ? ((ViewBag.PendingReviewCount ?? 0) * 100 / allClaims.Count) : 0)%"></div>
            </div>
        </div>
    </div>

    <div class="stat-card warning">
        <div class="stat-icon">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="stat-content">
            <h3>@pendingManagerReviewCount</h3>
            <p>WITH MANAGER</p>
            <small class="text-muted">Pending final approval</small>
            <div class="stat-trend">
                <i class="fas fa-clock text-warning me-1"></i>
                <span class="text-warning">Manager Review</span>
            </div>
        </div>
    </div>

    <div class="stat-card approved">
        <div class="stat-icon">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="stat-content">
            <h3>@(ViewBag.ApprovedTodayCount ?? 0)</h3>
            <p>APPROVED TODAY</p>
            <small class="text-muted">By coordinator</small>
            <div class="stat-trend">
                <i class="fas fa-calendar-day text-success me-1"></i>
                <span class="text-success">Daily Progress</span>
            </div>
        </div>
    </div>

    <div class="stat-card total">
        <div class="stat-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div class="stat-content">
            <h3>@(ViewBag.TotalClaimsCount ?? 0)</h3>
            <p>TOTAL CLAIMS</p>
            <small class="text-muted">All departments</small>
            <div class="stat-progress">
                <div class="progress-bar" style="width: @(allClaims.Count > 0 ? 100 : 0)%"></div>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-section">
    <div class="section-header">
        <h3><i class="fas fa-clipboard-check me-2"></i>Claims Requiring Your Approval</h3>
        <span class="badge bg-warning">@pendingClaims.Count Pending</span>
    </div>

    @if (pendingClaims.Any())
    {
        <div class="table-responsive">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Lecturer</th>
                        <th>Department</th>
                        <th>Reference</th>
                        <th>Month</th>
                        <th>Hours</th>
                        <th>Amount</th>
                        <th>Submitted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in pendingClaims)
                    {
                        <tr>
                            <td>@claim.LecturerName</td>
                            <td><span class="department-tag">@claim.Department</span></td>
                            <td>
                                <div class="claim-ref">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                    @claim.Id
                                </div>
                            </td>
                            <td>@claim.Month</td>
                            <td><span class="hours-badge">@claim.HoursWorked hrs</span></td>
                            <td><span class="amount">R@(claim.TotalAmount.ToString("N0"))</span></td>
                            <td>
                                <small class="text-muted">@((DateTime.Now - claim.SubmittedDate).Days) days ago</small>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-controller="ProgrammeCoordinator" asp-action="ClaimDetails" asp-route-id="@claim.Id" class="btn-action view" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form method="post" asp-action="ApproveClaim" asp-controller="ProgrammeCoordinator" style="display: inline;" onsubmit="return confirm('Are you sure you want to approve this claim? It will be sent to the manager for final approval.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@claim.Id" />
                                        <button type="submit" class="btn-action approve" title="Approve Claim">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn-action reject reject-btn" title="Reject Claim" data-claim-id="@claim.Id">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-check-circle empty-icon"></i>
            <h4>No Pending Claims</h4>
            <p>There are no claims requiring your approval at the moment.</p>
        </div>
    }
</div>

@if (pendingManagerReviewCount > 0)
{
    <div class="dashboard-section">
        <div class="section-header">
            <h3><i class="fas fa-user-tie me-2"></i>Claims Pending Manager Review</h3>
            <span class="badge bg-info">@pendingManagerReviewCount With Manager</span>
        </div>
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>@pendingManagerReviewCount claims</strong> have been approved by you and are now waiting for final approval from the Academic Manager.
        </div>
        <div class="table-responsive">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Lecturer</th>
                        <th>Department</th>
                        <th>Reference</th>
                        <th>Month</th>
                        <th>Hours</th>
                        <th>Amount</th>
                        <th>Approved By You</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in allClaims.Where(c => c.Status == "Pending" && c.CoordinatorApproved))
                    {
                        <tr>
                            <td>@claim.LecturerName</td>
                            <td><span class="department-tag">@claim.Department</span></td>
                            <td>
                                <div class="claim-ref">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                    @claim.Id
                                </div>
                            </td>
                            <td>@claim.Month</td>
                            <td><span class="hours-badge">@claim.HoursWorked hrs</span></td>
                            <td><span class="amount">R@(claim.TotalAmount.ToString("N0"))</span></td>
                            <td>
                                <small class="text-muted">
                                    @claim.CoordinatorApprovedBy<br />
                                    @claim.CoordinatorApprovedDate?.ToString("MMM dd, yyyy")
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.reject-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const claimId = this.getAttribute('data-claim-id');
                    const reason = prompt(`Please provide a reason for rejecting claim ${claimId}:`);

                    if (reason && reason.trim().length > 0) {
                        // Get the anti-forgery token
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                        const form = document.createElement('form');
                        form.method = 'post';
                        form.action = '@Url.Action("RejectClaim", "ProgrammeCoordinator")';

                        // Add anti-forgery token if available
                        if (token) {
                            const tokenInput = document.createElement('input');
                            tokenInput.type = 'hidden';
                            tokenInput.name = '__RequestVerificationToken';
                            tokenInput.value = token;
                            form.appendChild(tokenInput);
                        }

                        const claimIdInput = document.createElement('input');
                        claimIdInput.type = 'hidden';
                        claimIdInput.name = 'id';
                        claimIdInput.value = claimId;

                        const reasonInput = document.createElement('input');
                        reasonInput.type = 'hidden';
                        reasonInput.name = 'rejectionReason';
                        reasonInput.value = reason.trim();

                        form.appendChild(claimIdInput);
                        form.appendChild(reasonInput);
                        document.body.appendChild(form);
                        form.submit();
                    } else if (reason !== null) {
                        alert('Please provide a valid rejection reason.');
                    }
                });
            });
        });
    </script>
}