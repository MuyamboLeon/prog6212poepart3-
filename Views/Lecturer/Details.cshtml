@model The_CMCS.Models.Claim
@{
    ViewData["Title"] = "Claim Details";
    var currentUser = ViewBag.CurrentUser as The_CMCS.Models.User;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h2">Claim Details</h1>
                        <p class="text-muted">View detailed information about your claim</p>
                    </div>
                    <a class="btn btn-outline-secondary" asp-action="Dashboard">
                        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <!-- Claim Information Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-invoice-dollar me-2"></i>
                        Claim @Model.Id
                        <span class="status-badge status-@Model.Status.ToLower() float-end">
                            <i class="fas @(Model.Status == "Pending" ? "fa-clock" : Model.Status == "Approved" ? "fa-check" : "fa-times") me-1"></i>
                            @Model.Status.ToUpper()
                        </span>
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label class="form-label">Reference Number:</label>
                                <span class="value">@Model.Id</span>
                            </div>
                            <div class="detail-item">
                                <label class="form-label">Submitted By:</label>
                                <span class="value">@Model.LecturerName</span>
                            </div>
                            <div class="detail-item">
                                <label class="form-label">Department:</label>
                                <span class="value">@Model.Department</span>
                            </div>
                            <div class="detail-item">
                                <label class="form-label">Claim Month:</label>
                                <span class="value">@Model.Month</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item">
                                <label class="form-label">Hours Worked:</label>
                                <span class="value">@Model.HoursWorked hours</span>
                            </div>
                            <div class="detail-item">
                                <label class="form-label">Hourly Rate:</label>
                                <span class="value">R@(Model.HourlyRate.ToString("N2"))</span>
                            </div>
                            <div class="detail-item">
                                <label class="form-label">Total Amount:</label>
                                <span class="value total-amount">R@(Model.TotalAmount.ToString("N2"))</span>
                            </div>
                            <div class="detail-item">
                                <label class="form-label">Submitted Date:</label>
                                <span class="value">@Model.SubmittedDate.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="detail-item mt-3">
                        <label class="form-label">Description:</label>
                        <div class="description-box">
                            @Model.Description
                        </div>
                    </div>
                </div>
            </div>

            <!-- Approval Workflow Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-tasks me-2"></i>Approval Workflow
                    </h5>
                </div>
                <div class="card-body">
                    <div class="progress-tracker">
                        <div class="tracker-step completed">
                            <div class="step-icon">
                                <i class="fas fa-file-upload"></i>
                            </div>
                            <div class="step-label">
                                <div>Submitted</div>
                                <small class="text-muted">@Model.SubmittedDate.ToString("MMM dd")</small>
                            </div>
                        </div>

                        <div class="tracker-step @(Model.CoordinatorApproved ? "completed" : Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.CoordinatorApprovedBy) ? "rejected" : Model.Status == "Pending" ? "active" : "")">
                            <div class="step-icon">
                                <i class="fas @(Model.CoordinatorApproved ? "fa-user-check" : Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.CoordinatorApprovedBy) ? "fa-times" : Model.Status == "Pending" ? "fa-user" : "fa-clock")"></i>
                            </div>
                            <div class="step-label">
                                <div>Coordinator Review</div>
                                @if (Model.CoordinatorApproved)
                                {
                                    <small class="text-muted">Approved @Model.CoordinatorApprovedDate?.ToString("MMM dd")</small>
                                }
                                else if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.CoordinatorApprovedBy))
                                {
                                    <small class="text-muted">Rejected @Model.CoordinatorApprovedDate?.ToString("MMM dd")</small>
                                }
                                else
                                {
                                    <small class="text-muted">Pending</small>
                                }
                            </div>
                        </div>

                        <div class="tracker-step @(Model.ManagerApproved ? "completed" : Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.ManagerApprovedBy) ? "rejected" : Model.CoordinatorApproved ? "active" : "")">
                            <div class="step-icon">
                                <i class="fas @(Model.ManagerApproved ? "fa-user-tie" : Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.ManagerApprovedBy) ? "fa-times" : Model.CoordinatorApproved ? "fa-user-tie" : "fa-clock")"></i>
                            </div>
                            <div class="step-label">
                                <div>Manager Review</div>
                                @if (Model.ManagerApproved)
                                {
                                    <small class="text-muted">Approved @Model.ManagerApprovedDate?.ToString("MMM dd")</small>
                                }
                                else if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.ManagerApprovedBy))
                                {
                                    <small class="text-muted">Rejected @Model.ManagerApprovedDate?.ToString("MMM dd")</small>
                                }
                                else if (Model.CoordinatorApproved)
                                {
                                    <small class="text-muted">Pending</small>
                                }
                                else
                                {
                                    <small class="text-muted">Waiting for Coordinator</small>
                                }
                            </div>
                        </div>

                        <div class="tracker-step @(Model.Status == "Approved" ? "completed" : "")">
                            <div class="step-icon">
                                <i class="fas @(Model.Status == "Approved" ? "fa-check-double" : "fa-file-invoice-dollar")"></i>
                            </div>
                            <div class="step-label">
                                <div>Final Approval</div>
                                @if (Model.Status == "Approved")
                                {
                                    <small class="text-muted">Completed @Model.ReviewedDate?.ToString("MMM dd")</small>
                                }
                                else
                                {
                                    <small class="text-muted">Pending</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Approval Details -->
            @if (Model.CoordinatorApproved)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-user-check me-2"></i>Coordinator Approval
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="approval-details">
                            <div class="approval-item">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>Approved by:</strong> @Model.CoordinatorApprovedBy
                            </div>
                            <div class="approval-item">
                                <i class="fas fa-calendar me-2"></i>
                                <strong>Date:</strong> @Model.CoordinatorApprovedDate?.ToString("MMM dd, yyyy 'at' hh:mm tt")
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.ManagerApproved)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-user-tie me-2"></i>Manager Approval
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="approval-details">
                            <div class="approval-item">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                <strong>Approved by:</strong> @Model.ManagerApprovedBy
                            </div>
                            <div class="approval-item">
                                <i class="fas fa-calendar me-2"></i>
                                <strong>Date:</strong> @Model.ManagerApprovedDate?.ToString("MMM dd, yyyy 'at' hh:mm tt")
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-times-circle me-2"></i>Rejection Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="rejection-details">
                            <div class="rejection-reason">
                                <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                <strong>Reason:</strong> @Model.RejectionReason
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ReviewedBy))
                            {
                                <div class="rejection-item mt-2">
                                    <i class="fas fa-user me-2"></i>
                                    <strong>Rejected by:</strong> @Model.ReviewedBy
                                </div>
                                <div class="rejection-item">
                                    <i class="fas fa-calendar me-2"></i>
                                    <strong>Date:</strong> @Model.ReviewedDate?.ToString("MMM dd, yyyy 'at' hh:mm tt")
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="action-buttons-vertical">
                        <a href="#" class="btn btn-outline-primary btn-block mb-2">
                            <i class="fas fa-download me-2"></i>Export PDF
                        </a>
                        <a href="#" class="btn btn-outline-secondary btn-block mb-2">
                            <i class="fas fa-print me-2"></i>Print
                        </a>
                        @if (Model.Status == "Pending" && !Model.CoordinatorApproved)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-block mb-2">
                                <i class="fas fa-edit me-2"></i>Edit Claim
                            </a>
                        }
                        <a asp-action="Dashboard" class="btn btn-outline-info btn-block">
                            <i class="fas fa-list me-2"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>

            <!-- Supporting Documents -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-paperclip me-2"></i>Supporting Documents
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Documents != null && Model.Documents.Any())
                    {
                        <div class="documents-list">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="document-item">
                                    <i class="fas @GetFileIcon(doc.FileName) me-2"></i>
                                    <div class="document-info">
                                        <div class="document-name">@doc.FileName</div>
                                        <small class="text-muted">@doc.UploadedDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <a href="@Url.Action("DownloadDocument", "Lecturer", new { id = doc.Id })" class="document-download" title="Download">
                                        <i class="fas fa-download"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="no-documents text-center py-3">
                            <i class="fas fa-file-excel fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No supporting documents</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Status Summary -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Current Status
                    </h5>
                </div>
                <div class="card-body">
                    <div class="status-content">
                        @if (Model.Status == "Approved")
                        {
                            <div class="status-message success">
                                <i class="fas fa-check-circle me-2"></i>
                                <strong>Claim Fully Approved!</strong>
                                <p class="mb-0 mt-1">Your claim has been approved by both Coordinator and Manager. Payment processing will begin shortly.</p>
                            </div>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <div class="status-message error">
                                <i class="fas fa-times-circle me-2"></i>
                                <strong>Claim Rejected</strong>
                                <p class="mb-0 mt-1">Your claim has been rejected. Please review the rejection reason above.</p>
                            </div>
                        }
                        else if (Model.CoordinatorApproved)
                        {
                            <div class="status-message info">
                                <i class="fas fa-user-tie me-2"></i>
                                <strong>With Academic Manager</strong>
                                <p class="mb-0 mt-1">Your claim has been approved by the coordinator and is now with the academic manager for final approval.</p>
                            </div>
                        }
                        else
                        {
                            <div class="status-message warning">
                                <i class="fas fa-clock me-2"></i>
                                <strong>Under Coordinator Review</strong>
                                <p class="mb-0 mt-1">Your claim is currently being reviewed by the programme coordinator.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetFileIcon(string fileName)
    {
        if (string.IsNullOrEmpty(fileName))
            return "fa-file text-secondary";

        var extension = System.IO.Path.GetExtension(fileName)?.ToLower();
        return extension switch
        {
            ".pdf" => "fa-file-pdf text-danger",
            ".doc" => "fa-file-word text-primary",
            ".docx" => "fa-file-word text-primary",
            ".xls" => "fa-file-excel text-success",
            ".xlsx" => "fa-file-excel text-success",
            ".jpg" => "fa-file-image text-warning",
            ".jpeg" => "fa-file-image text-warning",
            ".png" => "fa-file-image text-warning",
            ".gif" => "fa-file-image text-warning",
            _ => "fa-file text-secondary"
        };
    }
}

@section Scripts {
    <style>
        .page-header {
            padding: 20px 0;
            border-bottom: 2px solid #e9ecef;
            margin-bottom: 30px;
        }

        .card {
            border: none;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            border-radius: 12px;
            margin-bottom: 24px;
        }

        .card-header {
            background: linear-gradient(135deg, #2c3e50, #34495e);
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0 !important;
        }

            .card-header h5 {
                margin: 0;
                font-weight: 600;
            }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }

        .status-approved {
            background-color: #d1edff;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .status-rejected {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .detail-item {
            margin-bottom: 20px;
        }

            .detail-item label {
                font-weight: 600;
                color: #6c757d;
                display: block;
                margin-bottom: 5px;
                font-size: 14px;
            }

            .detail-item .value {
                color: #2c3e50;
                font-size: 16px;
                font-weight: 500;
            }

        .total-amount {
            font-size: 18px !important;
            font-weight: 700 !important;
            color: #27ae60 !important;
        }

        .description-box {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
            line-height: 1.6;
            color: #495057;
        }

        /* Progress Tracker */
        .progress-tracker {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
            position: relative;
        }

            .progress-tracker:before {
                content: '';
                position: absolute;
                top: 25px;
                left: 0;
                right: 0;
                height: 3px;
                background-color: #e9ecef;
                z-index: 1;
            }

        .tracker-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 2;
            flex: 1;
            text-align: center;
        }

        .step-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: #e9ecef;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 8px;
            color: #6c757d;
            font-size: 18px;
            border: 3px solid white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .step-label {
            font-size: 12px;
            color: #6c757d;
            font-weight: 500;
            text-align: center;
        }

            .step-label div {
                font-weight: 600;
                margin-bottom: 2px;
            }

        .tracker-step.active .step-icon {
            background-color: #3498db;
            color: white;
            border-color: #3498db;
        }

        .tracker-step.active .step-label {
            color: #3498db;
            font-weight: 600;
        }

        .tracker-step.completed .step-icon {
            background-color: #27ae60;
            color: white;
            border-color: #27ae60;
        }

        .tracker-step.completed .step-label {
            color: #27ae60;
        }

        .tracker-step.rejected .step-icon {
            background-color: #e74c3c;
            color: white;
            border-color: #e74c3c;
        }

        .tracker-step.rejected .step-label {
            color: #e74c3c;
        }

        /* Approval Details */
        .approval-details, .rejection-details {
            padding: 10px 0;
        }

        .approval-item, .rejection-item {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            color: #495057;
        }

        .rejection-reason {
            display: flex;
            align-items: flex-start;
            margin-bottom: 15px;
            color: #721c24;
            line-height: 1.5;
        }

        /* Action Buttons */
        .action-buttons-vertical {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-block {
            width: 100%;
            text-align: left;
            padding: 12px 15px;
        }

        /* Documents */
        .documents-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .document-item {
            display: flex;
            align-items: center;
            padding: 12px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 3px solid #3498db;
        }

        .document-info {
            flex: 1;
        }

        .document-name {
            font-weight: 500;
            color: #2c3e50;
            font-size: 14px;
        }

        .document-download {
            color: #3498db;
            padding: 5px;
            border-radius: 4px;
            transition: background-color 0.3s;
        }

            .document-download:hover {
                background-color: #ebf5fb;
                color: #2980b9;
            }

        .no-documents {
            color: #6c757d;
        }

        /* Status Messages */
        .status-message {
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid;
        }

            .status-message.success {
                background-color: #d5f5e3;
                border-left-color: #27ae60;
                color: #155724;
            }

            .status-message.error {
                background-color: #fadbd8;
                border-left-color: #e74c3c;
                color: #721c24;
            }

            .status-message.warning {
                background-color: #fff3cd;
                border-left-color: #ffc107;
                color: #856404;
            }

            .status-message.info {
                background-color: #d1ecf1;
                border-left-color: #17a2b8;
                color: #0c5460;
            }

        .btn {
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s;
        }

        .btn-outline-secondary {
            border: 2px solid #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                color: white;
                transform: translateY(-1px);
            }

        .btn-primary {
            background: linear-gradient(135deg, #3498db, #2980b9);
            border: none;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(52, 152, 219, 0.4);
            }
    </style>
}