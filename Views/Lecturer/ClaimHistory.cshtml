@model List<The_CMCS.Models.Claim>?
@{
    ViewData["Title"] = "Claim History";
    var claims = Model ?? new List<The_CMCS.Models.Claim>();
}

<div class="page-header">
    <div class="header-content">
        <div class="title-section">
            <h1><i class="fas fa-history me-3"></i>Claim History</h1>
            <p class="text-muted">Complete history of all your submitted claims</p>
        </div>
        <div class="header-actions">
            <a asp-controller="Lecturer" asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
            <a asp-controller="Claims" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>New Claim
            </a>
        </div>
    </div>
</div>

<div class="history-container">
    <div class="filters-section">
        <div class="filter-group">
            <label>Filter by Status:</label>
            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all">All</button>
                <button class="filter-btn" data-filter="pending">Pending</button>
                <button class="filter-btn" data-filter="approved">Approved</button>
                <button class="filter-btn" data-filter="rejected">Rejected</button>
            </div>
        </div>
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search claims...">
        </div>
    </div>

    <div class="claims-history">
        @if (claims.Any())
        {
            <div class="table-responsive">
                <table class="history-table" id="claimsTable">
                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Month</th>
                            <th>Department</th>
                            <th>Hours</th>
                            <th>Rate</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Submitted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in claims.OrderByDescending(c => c.SubmittedDate))
                        {
                            <tr class="claim-row" data-status="@claim.Status.ToLower()">
                                <td>
                                    <div class="claim-reference">
                                        <i class="fas fa-file-invoice-dollar me-2"></i>
                                        <strong>@claim.Id</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="month-badge">@claim.Month</span>
                                </td>
                                <td>
                                    <span class="department-label">@claim.Department</span>
                                </td>
                                <td>
                                    <div class="hours-display">
                                        <span class="hours">@claim.HoursWorked</span>
                                        <small class="text-muted">hours</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="rate">R@claim.HourlyRate</span>
                                </td>
                                <td>
                                    <span class="amount-value">R@(claim.HoursWorked* claim.HourlyRate)</span>
                                </td>
                                <td>
                                    <span class="status-indicator status-@claim.Status.ToLower()">
                                        <i class="fas @(claim.Status == "pending" ? "fa-clock" : claim.Status == "approved" ? "fa-check" : "fa-times") me-1"></i>
                                        @claim.Status.ToUpper()
                                    </span>
                                </td>
                                <td>
                                    <div class="date-info">
                                        <div class="date">@claim.SubmittedDate.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@claim.SubmittedDate.ToString("hh:mm tt")</small>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-controller="Claims" asp-action="Details" asp-route-id="@claim.Id" class="btn-action view" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (claim.Status == "pending")
                                        {
                                            <a href="#" class="btn-action edit" title="Edit Claim">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="#" class="btn-action delete" title="Delete Claim">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="history-summary">
                <div class="summary-card">
                    <h4>Summary</h4>
                    <div class="summary-stats">
                        <div class="summary-item">
                            <span class="label">Total Claims:</span>
                            <span class="value">@claims.Count</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">Total Amount:</span>
                            <span class="value">R@(claims.Sum(c => c.TotalAmount).ToString("N0"))</span>
                        </div>
                        <div class="summary-item">
                            <span class="label">Average per Claim:</span>
                            <span class="value">R@(claims.Count > 0 ? (claims.Sum(c => c.TotalAmount) / claims.Count).ToString("N0") : "0")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-history">
                <div class="empty-icon">
                    <i class="fas fa-file-invoice fa-4x"></i>
                </div>
                <h3>No Claim History</h3>
                <p class="text-muted">You haven't submitted any claims yet. Start by creating your first claim.</p>
                <a class="btn btn-primary mt-4" asp-controller="Claims" asp-action="Create">
                    <i class="fas fa-plus-circle me-2"></i>Create Your First Claim
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filter-btn');
            const searchInput = document.getElementById('searchInput');
            const claimRows = document.querySelectorAll('.claim-row');

            // Filter functionality
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const filter = this.getAttribute('data-filter');

                    // Update active button
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    // Filter rows
                    claimRows.forEach(row => {
                        if (filter === 'all' || row.getAttribute('data-status') === filter) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });

            // Search functionality
            searchInput.addEventListener('keyup', function() {
                const filter = this.value.toLowerCase();
                claimRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    if (text.indexOf(filter) > -1) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
    </script>

    <style>
        .page-header {
            background: linear-gradient(135deg, #2c3e50, #34495e);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .title-section h1 {
            margin: 0;
            font-size: 2.5rem;
            font-weight: 700;
        }

        .title-section p {
            margin: 5px 0 0 0;
            opacity: 0.9;
            font-size: 1.1rem;
        }

        .header-actions {
            display: flex;
            gap: 15px;
        }

        .history-container {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .filters-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f8f9fa;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }

            .filter-group label {
                font-weight: 600;
                color: #495057;
                margin: 0;
            }

        .filter-buttons {
            display: flex;
            gap: 8px;
        }

        .filter-btn {
            padding: 8px 16px;
            border: 2px solid #e9ecef;
            background: white;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
        }

            .filter-btn.active,
            .filter-btn:hover {
                background: #3498db;
                color: white;
                border-color: #3498db;
            }

        .search-box {
            position: relative;
        }

            .search-box i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }

            .search-box input {
                padding: 10px 15px 10px 40px;
                border: 2px solid #e9ecef;
                border-radius: 25px;
                font-size: 14px;
                width: 250px;
                transition: border-color 0.3s;
            }

                .search-box input:focus {
                    outline: none;
                    border-color: #3498db;
                }

        .history-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

            .history-table th {
                background: linear-gradient(135deg, #f8f9fa, #e9ecef);
                padding: 15px 12px;
                text-align: left;
                font-weight: 600;
                color: #495057;
                border-bottom: 3px solid #dee2e6;
            }

            .history-table td {
                padding: 15px 12px;
                border-bottom: 1px solid #e9ecef;
                vertical-align: middle;
            }

            .history-table tbody tr {
                transition: all 0.3s;
            }

                .history-table tbody tr:hover {
                    background-color: #f8f9fa;
                    transform: translateX(5px);
                }

        .claim-reference {
            display: flex;
            align-items: center;
            font-weight: 500;
        }

        .month-badge {
            background: #e3f2fd;
            color: #1976d2;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 13px;
        }

        .department-label {
            color: #495057;
            font-weight: 500;
        }

        .hours-display {
            text-align: center;
        }

        .hours {
            font-weight: 700;
            color: #2c3e50;
            font-size: 16px;
        }

        .rate {
            color: #6c757d;
            font-weight: 500;
        }

        .amount-value {
            font-weight: 700;
            color: #27ae60;
            font-size: 15px;
        }

        .status-indicator {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-flex;
            align-items: center;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }

        .status-approved {
            background-color: #d1edff;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .status-rejected {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .date-info {
            text-align: center;
        }

        .date {
            font-weight: 500;
            color: #2c3e50;
        }

        .action-buttons {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn-action {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.3s;
            border: none;
        }

            .btn-action.view {
                background: #3498db;
                color: white;
            }

            .btn-action.edit {
                background: #f39c12;
                color: white;
            }

            .btn-action.delete {
                background: #e74c3c;
                color: white;
            }

            .btn-action:hover {
                transform: translateY(-2px);
                box-shadow: 0 3px 10px rgba(0,0,0,0.2);
            }

        .history-summary {
            border-top: 2px solid #e9ecef;
            padding-top: 20px;
        }

        .summary-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
        }

            .summary-card h4 {
                margin: 0 0 15px 0;
                color: #2c3e50;
                font-weight: 600;
            }

        .summary-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

            .summary-item .label {
                color: #6c757d;
                font-weight: 500;
            }

            .summary-item .value {
                color: #2c3e50;
                font-weight: 700;
                font-size: 16px;
            }

        .empty-history {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            color: #bdc3c7;
            margin-bottom: 20px;
        }

        .empty-history h3 {
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .btn {
            border-radius: 10px;
            padding: 12px 25px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db, #2980b9);
            border: none;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
            }

        .btn-outline-secondary {
            border: 2px solid #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                color: white;
            }

        @@media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }

            .filters-section {
                flex-direction: column;
                gap: 20px;
            }

            .filter-group {
                flex-direction: column;
                align-items: flex-start;
            }

            .search-box input {
                width: 100%;
            }
        }
    </style>
}