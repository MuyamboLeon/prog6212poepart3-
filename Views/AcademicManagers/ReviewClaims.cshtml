@model IEnumerable<The_CMCS.Models.Claim>

@{
    ViewData["Title"] = "Review Claims";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Review Claims</h1>
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Pending Claims for Review</h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <p class="text-muted">No pending claims to review. All claims have been processed.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Lecturer</th>
                                <th>Department</th>
                                <th>Reference</th>
                                <th>Month</th>
                                <th>Hours</th>
                                <th>Amount</th>
                                <th>Submitted Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in Model)
                            {
                                <tr>
                                    <td>@claim.LecturerName</td>
                                    <td>@claim.Department</td>
                                    <td>
                                        <div class="claim-ref">
                                            <i class="fas fa-file-invoice-dollar"></i>
                                            @claim.Id
                                        </div>
                                    </td>
                                    <td>@claim.Month</td>
                                    <td><span class="badge badge-primary">@claim.HoursWorked hrs</span></td>
                                    <td><strong>R @claim.TotalAmount.ToString("N2")</strong></td>
                                    <td>@claim.SubmittedDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("ClaimDetails", new { id = claim.Id })"
                                               class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button" class="btn btn-success btn-sm"
                                                    data-toggle="modal" data-target="#approveModal-@claim.Id" title="Approve">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    data-toggle="modal" data-target="#rejectModal-@claim.Id" title="Reject">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>

                                        <!-- Approve Modal -->
                                        <div class="modal fade" id="approveModal-@claim.Id" tabindex="-1" role="dialog">
                                            <div class="modal-dialog" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Approve Claim</h5>
                                                        <button type="button" class="close" data-dismiss="modal">
                                                            <span>&times;</span>
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Are you sure you want to approve this claim?</p>
                                                        <p><strong>Reference:</strong> @claim.Id</p>
                                                        <p><strong>Lecturer:</strong> @claim.LecturerName</p>
                                                        <p><strong>Department:</strong> @claim.Department</p>
                                                        <p><strong>Hours:</strong> @claim.HoursWorked</p>
                                                        <p><strong>Amount:</strong> R @claim.TotalAmount.ToString("N2")</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <form asp-action="ApproveClaim" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@claim.Id" />
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success">Approve Claim</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Reject Modal -->
                                        <div class="modal fade" id="rejectModal-@claim.Id" tabindex="-1" role="dialog">
                                            <div class="modal-dialog" role="document">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Reject Claim</h5>
                                                        <button type="button" class="close" data-dismiss="modal">
                                                            <span>&times;</span>
                                                        </button>
                                                    </div>
                                                    <form asp-action="RejectClaim" method="post">
                                                        <div class="modal-body">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@claim.Id" />
                                                            <p>Please provide a reason for rejecting this claim:</p>
                                                            <div class="form-group">
                                                                <label for="rejectionReason-@claim.Id">Rejection Reason</label>
                                                                <textarea class="form-control" id="rejectionReason-@claim.Id"
                                                                  name="rejectionReason" rows="3" required
                                                                  placeholder="Enter reason for rejection..."></textarea>
                                                                <small class="form-text text-muted">This reason will be visible to the lecturer.</small>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Reject Claim</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "order": [[6, "desc"]],
                "language": {
                    "emptyTable": "No pending claims found for review"
                }
            });

            // Clear success/error messages after 5 seconds
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        });
    </script>
}