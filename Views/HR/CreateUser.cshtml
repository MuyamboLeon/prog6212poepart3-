@model The_CMCS.Models.User
@{
    ViewData["Title"] = "Create New User";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" asp-controller="HR">HR Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="ManageUsers" asp-controller="HR">Manage Users</a></li>
                    <li class="breadcrumb-item active">Create User</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-user-plus me-2"></i>Create New User
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="CreateUser" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label">Full Name *</label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Username" class="form-label">Username</label>
                                    <input asp-for="Username" class="form-control" placeholder="Leave blank to auto-generate" />
                                    <small class="form-text text-muted">If left blank, username will be auto-generated</small>
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Role" class="form-label">Role *</label>
                                    <select asp-for="Role" class="form-select">
                                        <option value="">Select Role</option>
                                        <option value="Lecturer">Lecturer</option>
                                        <option value="Coordinator">Programme Coordinator</option>
                                        <option value="Manager">Academic Manager</option>
                                        <option value="HR">HR</option>
                                    </select>
                                    <span asp-validation-for="Role" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Department" class="form-label">Department *</label>
                                    <select asp-for="Department" class="form-select">
                                        <option value="">Select Department</option>
                                        <option value="Computer Science">Computer Science</option>
                                        <option value="Mathematics">Mathematics</option>
                                        <option value="Engineering">Engineering</option>
                                        <option value="Business">Business</option>
                                        <option value="Human Resources">Human Resources</option>
                                        <option value="All">All Departments</option>
                                    </select>
                                    <span asp-validation-for="Department" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label">Email Address *</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HourlyRate" class="form-label">Hourly Rate (R)</label>
                                    <input asp-for="HourlyRate" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <small class="form-text text-muted">Only applicable for Lecturers</small>
                                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label">Password</label>
                                    <input type="password" class="form-control" value="Welcome123" readonly />
                                    <small class="form-text text-muted">Default password: Welcome123</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group form-check mb-3">
                            <input asp-for="IsActive" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label">Active User</label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="ManageUsers" asp-controller="HR" class="btn btn-secondary me-md-2">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>Create User
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- User Role Information -->
            <div class="card mt-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Role Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Lecturer</h6>
                            <ul class="small">
                                <li>Can submit claims</li>
                                <li>View claim history</li>
                                <li>Edit pending claims</li>
                                <li>Requires hourly rate</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Coordinator</h6>
                            <ul class="small">
                                <li>Review department claims</li>
                                <li>Approve/reject claims</li>
                                <li>Department overview</li>
                                <li>No hourly rate needed</li>
                            </ul>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <h6>Manager</h6>
                            <ul class="small">
                                <li>Final claim approval</li>
                                <li>View all departments</li>
                                <li>Generate reports</li>
                                <li>System overview</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>HR</h6>
                            <ul class="small">
                                <li>User management</li>
                                <li>System administration</li>
                                <li>Reports & analytics</li>
                                <li>Full system access</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-generate username when name is entered
            $('#Name').on('blur', function() {
                if ($('#Username').val() === '') {
                    var fullName = $(this).val();
                    if (fullName.length > 0) {
                        var names = fullName.split(' ');
                        var firstName = names[0].toLowerCase();
                        var lastName = names.length > 1 ? names[names.length - 1].toLowerCase() : '';
                        var username = firstName + (lastName ? '.' + lastName : '');
                        $('#Username').val(username);
                    }
                }
            });

            // Show/hide hourly rate based on role
            $('#Role').on('change', function() {
                var role = $(this).val();
                var hourlyRateGroup = $('#HourlyRate').closest('.form-group');

                if (role === 'Lecturer') {
                    hourlyRateGroup.show();
                    $('#HourlyRate').prop('required', true);
                } else {
                    hourlyRateGroup.hide();
                    $('#HourlyRate').prop('required', false);
                    $('#HourlyRate').val('0');
                }
            });

            // Trigger change event on page load
            $('#Role').trigger('change');

            // Form validation
            $('form').on('submit', function(e) {
                var role = $('#Role').val();
                var department = $('#Department').val();

                if (!role) {
                    e.preventDefault();
                    alert('Please select a role for the user.');
                    return false;
                }

                if (!department) {
                    e.preventDefault();
                    alert('Please select a department for the user.');
                    return false;
                }
            });
        });
    </script>

    <style>
        .breadcrumb {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 0.75rem 1rem;
        }

        .card {
            border: none;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            margin-bottom: 1.5rem;
        }

        .card-header {
            border-bottom: 1px solid rgba(0, 0, 0, 0.125);
            padding: 1rem 1.25rem;
        }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            padding: 0.5rem 0.75rem;
        }

            .form-control:focus, .form-select:focus {
                border-color: #86b7fe;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

        .btn {
            border-radius: 0.375rem;
            padding: 0.5rem 1rem;
            font-weight: 500;
        }

        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

            .btn-primary:hover {
                background-color: #0b5ed7;
                border-color: #0a58ca;
            }

        .text-muted {
            font-size: 0.875rem;
        }

        .form-text {
            margin-top: 0.25rem;
        }

        ul {
            padding-left: 1.25rem;
            margin-bottom: 0;
        }

            ul li {
                margin-bottom: 0.25rem;
            }
    </style>
}