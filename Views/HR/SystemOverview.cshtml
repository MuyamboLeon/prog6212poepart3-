@model The_CMCS.Models.SystemOverviewViewModel
@{
    ViewData["Title"] = "System Overview";
    var currentYear = DateTime.Now.Year;
}

<style>
    .system-overview {
        background: #f8f9fa;
        min-height: 100vh;
    }

    .page-header {
        background: linear-gradient(135deg, #6c5ce7, #a29bfe);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .title-section h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: 700;
    }

    .title-section p {
        margin: 5px 0 0 0;
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        transition: transform 0.3s, box-shadow 0.3s;
        border-left: 4px solid;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        .stat-card.users {
            border-left-color: #3498db;
        }

        .stat-card.claims {
            border-left-color: #e74c3c;
        }

        .stat-card.financial {
            border-left-color: #27ae60;
        }

        .stat-card.system {
            border-left-color: #9b59b6;
        }

    .stat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: white;
    }

    .stat-card.users .stat-icon {
        background: #3498db;
    }

    .stat-card.claims .stat-icon {
        background: #e74c3c;
    }

    .stat-card.financial .stat-icon {
        background: #27ae60;
    }

    .stat-card.system .stat-icon {
        background: #9b59b6;
    }

    .stat-content h3 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .stat-content p {
        margin: 5px 0;
        color: #6c757d;
        font-weight: 500;
    }

    .stat-trend {
        display: flex;
        align-items: center;
        font-size: 0.8rem;
        margin-top: 5px;
    }

    .trend-up {
        color: #27ae60;
    }

    .trend-down {
        color: #e74c3c;
    }

    .dashboard-sections {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 30px;
        margin-bottom: 30px;
    }

    .section-card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #f8f9fa;
    }

        .section-header h3 {
            margin: 0;
            color: #2c3e50;
            font-weight: 600;
        }

    .chart-container {
        height: 300px;
        margin: 20px 0;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        .data-table th {
            background: #f8f9fa;
            padding: 12px 15px;
            text-align: left;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid #e9ecef;
        }

        .data-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #e9ecef;
            vertical-align: middle;
        }

        .data-table tbody tr:hover {
            background-color: #f8f9fa;
        }

    .progress-bar {
        height: 8px;
        background: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
        margin: 5px 0;
    }

    .progress-fill {
        height: 100%;
        border-radius: 4px;
    }

    .progress-users {
        background: #3498db;
    }

    .progress-claims {
        background: #e74c3c;
    }

    .progress-financial {
        background: #27ae60;
    }

    .metric-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-success {
        background: #d1edff;
        color: #0c5460;
    }

    .badge-warning {
        background: #fff3cd;
        color: #856404;
    }

    .badge-danger {
        background: #f8d7da;
        color: #721c24;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .action-btn {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        color: #495057;
        transition: all 0.3s;
        cursor: pointer;
    }

        .action-btn:hover {
            border-color: #3498db;
            color: #3498db;
            transform: translateY(-2px);
        }

    .refresh-btn {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

        .refresh-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(52, 152, 219, 0.4);
        }

    .last-updated {
        color: #6c757d;
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .dashboard-sections {
            grid-template-columns: 1fr;
        }

        .header-content {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }
    }
</style>

<div class="system-overview">
    <div class="page-header">
        <div class="header-content">
            <div class="title-section">
                <h1><i class="fas fa-tachometer-alt me-3"></i>System Overview</h1>
                <p class="text-muted">Comprehensive analytics and system performance metrics</p>
                <small class="last-updated">Last updated: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
            <div class="header-actions">
                <button class="refresh-btn" onclick="refreshData()">
                    <i class="fas fa-sync-alt me-2"></i>Refresh Data
                </button>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <!-- Key Statistics -->
        <div class="stats-grid">
            <div class="stat-card users">
                <div class="stat-header">
                    <div>
                        <h3>@Model.TotalUsers</h3>
                        <p>TOTAL USERS</p>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <i class="fas fa-user-plus text-success me-1"></i>
                    <span class="text-success">@Model.RecentUsers new this month</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill progress-users" style="width: @(Model.TotalUsers > 0 ? (Model.ActiveUsers * 100 / Model.TotalUsers) : 0)%"></div>
                </div>
                <small>@Model.ActiveUsers active • @Model.InactiveUsers inactive</small>
            </div>

            <div class="stat-card claims">
                <div class="stat-header">
                    <div>
                        <h3>@Model.TotalClaims</h3>
                        <p>TOTAL CLAIMS</p>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <i class="fas fa-chart-line text-success me-1"></i>
                    <span class="text-success">@Model.RecentClaims this month</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill progress-claims" style="width: @(Model.TotalClaims > 0 ? (Model.ApprovedClaims * 100 / Model.TotalClaims) : 0)%"></div>
                </div>
                <small>@Model.ApprovedClaims approved • @Model.PendingClaims pending • @Model.RejectedClaims rejected</small>
            </div>

            <div class="stat-card financial">
                <div class="stat-header">
                    <div>
                        <h3>R@(Model.TotalAmount.ToString("N0"))</h3>
                        <p>TOTAL PAYOUTS</p>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <i class="fas fa-check-circle text-success me-1"></i>
                    <span class="text-success">@Model.RecentApprovals approvals this month</span>
                </div>
                <small>Avg: R@(Model.AverageClaimAmount.ToString("N2")) • Max: R@(Model.HighestClaimAmount.ToString("N2"))</small>
            </div>

            <div class="stat-card system">
                <div class="stat-header">
                    <div>
                        <h3>@Model.SystemUptime</h3>
                        <p>SYSTEM UPTIME</p>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-server"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <i class="fas fa-user-clock text-info me-1"></i>
                    <span class="text-info">@Model.ActiveSessions active sessions</span>
                </div>
                <small>Storage: @Model.StorageUsage</small>
            </div>
        </div>

        <div class="dashboard-sections">
            <!-- Left Column -->
            <div>
                <!-- User Distribution by Role -->
                <div class="section-card mb-4">
                    <div class="section-header">
                        <h3><i class="fas fa-chart-pie me-2"></i>User Distribution by Role</h3>
                    </div>
                    <div class="chart-container" id="roleChart">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Total Users</th>
                                    <th>Active</th>
                                    <th>Distribution</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in Model.UsersByRole)
                                {
                                    <tr>
                                        <td>
                                            <span class="metric-badge badge-success">@role.Role</span>
                                        </td>
                                        <td>@role.Count</td>
                                        <td>@role.ActiveCount</td>
                                        <td>
                                            <div class="progress-bar">
                                                <div class="progress-fill progress-users"
                                                     style="width: @(Model.TotalUsers > 0 ? (role.Count * 100 / Model.TotalUsers) : 0)%"></div>
                                            </div>
                                            <small>@(Model.TotalUsers > 0 ? ((role.Count * 100 / Model.TotalUsers).ToString("F1")) : "0")%</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Department Performance -->
                <div class="section-card">
                    <div class="section-header">
                        <h3><i class="fas fa-building me-2"></i>Department Performance</h3>
                    </div>
                    <div class="chart-container" id="departmentChart">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th>Total Claims</th>
                                    <th>Approved</th>
                                    <th>Amount</th>
                                    <th>Success Rate</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dept in Model.ClaimsByDepartment)
                                {
                                    var successRate = dept.TotalClaims > 0 ? (dept.ApprovedClaims * 100 / dept.TotalClaims) : 0;
                                    <tr>
                                        <td><strong>@dept.Department</strong></td>
                                        <td>@dept.TotalClaims</td>
                                        <td>@dept.ApprovedClaims</td>
                                        <td>R@(dept.TotalAmount.ToString("N0"))</td>
                                        <td>
                                            <span class="metric-badge @(successRate >= 80 ? "badge-success" : successRate >= 60 ? "badge-warning" : "badge-danger")">
                                                @successRate.ToString("F1")%
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div>
                <!-- Monthly Trends -->
                <div class="section-card mb-4">
                    <div class="section-header">
                        <h3><i class="fas fa-chart-line me-2"></i>Monthly Trends</h3>
                    </div>
                    <div class="chart-container" id="trendChart">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th>Claims</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trend in Model.MonthlyTrends)
                                {
                                    <tr>
                                        <td>@trend.Period</td>
                                        <td>@trend.ClaimsCount</td>
                                        <td>R@(trend.ApprovedAmount.ToString("N0"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="section-card">
                    <div class="section-header">
                        <h3><i class="fas fa-bolt me-2"></i>Quick Actions</h3>
                    </div>
                    <div class="quick-actions">
                        <a asp-controller="HR" asp-action="ManageUsers" class="action-btn">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <div>Manage Users</div>
                        </a>
                        <a asp-controller="HR" asp-action="Reports" class="action-btn">
                            <i class="fas fa-chart-bar fa-2x mb-2"></i>
                            <div>View Reports</div>
                        </a>
                        <a asp-controller="HR" asp-action="BulkInvoices" class="action-btn">
                            <i class="fas fa-download fa-2x mb-2"></i>
                            <div>Bulk Invoices</div>
                        </a>
                        <button class="action-btn" onclick="exportData()">
                            <i class="fas fa-file-export fa-2x mb-2"></i>
                            <div>Export Data</div>
                        </button>
                    </div>
                </div>

                <!-- System Health -->
                <div class="section-card mt-4">
                    <div class="section-header">
                        <h3><i class="fas fa-heartbeat me-2"></i>System Health</h3>
                    </div>
                    <div class="system-health">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Uptime:</span>
                            <span class="text-success">@Model.SystemUptime</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Active Sessions:</span>
                            <span class="text-info">@Model.ActiveSessions</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Storage Usage:</span>
                            <span class="text-warning">@Model.StorageUsage</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Response Time:</span>
                            <span class="text-success">< 200ms</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function refreshData() {
            const btn = event.target;
            const originalText = btn.innerHTML;

            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Refreshing...';
            btn.disabled = true;

            // Simulate API call
            setTimeout(() => {
                location.reload();
            }, 1000);
        }

        function exportData() {
            // Simulate export functionality
            alert('Export functionality would be implemented here. This would generate a comprehensive system report.');
        }

        // Auto-refresh every 5 minutes
        setInterval(() => {
            console.log('Auto-refreshing system overview data...');
            // In a real application, you might want to use AJAX to refresh specific components
        }, 300000); // 5 minutes

        document.addEventListener('DOMContentLoaded', function() {
            console.log('System Overview loaded successfully');

            // Add some interactive features
            const statCards = document.querySelectorAll('.stat-card');
            statCards.forEach(card => {
                card.addEventListener('click', function() {
                    this.style.transform = 'scale(1.02)';
                    setTimeout(() => {
                        this.style.transform = '';
                    }, 150);
                });
            });
        });
    </script>
}