@{
    ViewData["Title"] = "System Overview";
    var overview = ViewBag.SystemOverview as Dictionary<string, object> ?? new Dictionary<string, object>();
}

<style>
    .page-header {
        background: linear-gradient(135deg, #e67e22, #d35400);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .title-section h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: 700;
    }

    .title-section p {
        margin: 5px 0 0 0;
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .system-overview-container {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .overview-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 25px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        text-align: center;
        border-left: 4px solid;
        transition: transform 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-card.primary {
            border-left-color: #3498db;
        }

        .stat-card.success {
            border-left-color: #27ae60;
        }

        .stat-card.warning {
            border-left-color: #f39c12;
        }

        .stat-card.danger {
            border-left-color: #e74c3c;
        }

        .stat-card.info {
            border-left-color: #9b59b6;
        }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .stat-card.primary .stat-number {
        color: #3498db;
    }

    .stat-card.success .stat-number {
        color: #27ae60;
    }

    .stat-card.warning .stat-number {
        color: #f39c12;
    }

    .stat-card.danger .stat-number {
        color: #e74c3c;
    }

    .stat-card.info .stat-number {
        color: #9b59b6;
    }

    .stat-label {
        color: #6c757d;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .chart-container {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #e9ecef;
    }

    .chart-title {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 15px;
        text-align: center;
        font-size: 1.1rem;
    }

    .chart-placeholder {
        background: white;
        border-radius: 8px;
        padding: 40px 20px;
        text-align: center;
        color: #6c757d;
        border: 2px dashed #dee2e6;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        background: white;
        border-radius: 8px;
        overflow: hidden;
    }

        .data-table th {
            background: #e9ecef;
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid #dee2e6;
        }

        .data-table td {
            padding: 12px;
            border-bottom: 1px solid #dee2e6;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

    .top-lecturers {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 25px;
        margin-top: 20px;
        border: 1px solid #e9ecef;
    }

    .section-title {
        color: #2c3e50;
        font-weight: 600;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }

    .system-info {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 25px;
        margin-top: 30px;
        border: 1px solid #e9ecef;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        font-weight: 600;
        color: #495057;
    }

    .info-value {
        color: #2c3e50;
        font-weight: 500;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-operational {
        background-color: #d1edff;
        color: #0c5460;
    }

    .progress-container {
        margin-top: 10px;
    }

    .progress {
        height: 8px;
        background-color: #e9ecef;
        border-radius: 4px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        border-radius: 4px;
    }

    .progress-success {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
    }

    .progress-warning {
        background: linear-gradient(135deg, #f39c12, #e67e22);
    }

    .progress-danger {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-outline-light {
        background: transparent;
        color: white;
        border: 2px solid rgba(255,255,255,0.3);
    }

        .btn-outline-light:hover {
            background: rgba(255,255,255,0.1);
            transform: translateY(-2px);
        }

    @@media (max-width: 768px) {
        .header-content {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .charts-grid {
            grid-template-columns: 1fr;
        }

        .overview-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <div class="header-content">
        <div class="title-section">
            <h1><i class="fas fa-tachometer-alt me-3"></i>System Overview</h1>
            <p class="text-muted">Comprehensive analytics and system performance metrics</p>
        </div>
        <div class="header-actions">
            <a asp-controller="HR" asp-action="Dashboard" class="btn btn-outline-light">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>
</div>

<div class="system-overview-container">
    <!-- Key Statistics -->
    <div class="overview-stats">
        <div class="stat-card primary">
            <div class="stat-number">@(overview.ContainsKey("TotalUsers") ? overview["TotalUsers"] : 0)</div>
            <div class="stat-label">TOTAL USERS</div>
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar progress-success" style="width: 100%"></div>
                </div>
            </div>
        </div>

        <div class="stat-card success">
            <div class="stat-number">@(overview.ContainsKey("TotalClaims") ? overview["TotalClaims"] : 0)</div>
            <div class="stat-label">TOTAL CLAIMS</div>
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar progress-success" style="width: 100%"></div>
                </div>
            </div>
        </div>

        <div class="stat-card warning">
            <div class="stat-number">R@(overview.ContainsKey("TotalAmount") ? ((decimal)overview["TotalAmount"]).ToString("N0") : "0")</div>
            <div class="stat-label">TOTAL PAYOUTS</div>
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar progress-warning" style="width: 100%"></div>
                </div>
            </div>
        </div>

        <div class="stat-card danger">
            <div class="stat-number">@(overview.ContainsKey("PendingClaims") ? overview["PendingClaims"] : 0)</div>
            <div class="stat-label">PENDING CLAIMS</div>
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar progress-danger" style="width: 100%"></div>
                </div>
            </div>
        </div>

        <div class="stat-card info">
            <div class="stat-number">@(overview.ContainsKey("ActiveUsers") ? overview["ActiveUsers"] : 0)</div>
            <div class="stat-label">ACTIVE USERS</div>
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar progress-success"
                         style="width: @(overview.ContainsKey("TotalUsers") && overview.ContainsKey("ActiveUsers") ?
                                                  ((int)overview["ActiveUsers"] * 100 / (int)overview["TotalUsers"]) : 100)%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Data Grids -->
    <div class="charts-grid">
        <!-- Users by Role -->
        <div class="chart-container">
            <h4 class="chart-title"><i class="fas fa-users me-2"></i>Users by Role</h4>
            @if (overview.ContainsKey("UsersByRole"))
            {
                var usersByRole = overview["UsersByRole"] as Dictionary<string, int>;
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Count</th>
                            <th>Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var totalUsers = usersByRole.Values.Sum();
                        }
                        @foreach (var role in usersByRole)
                        {
                            var percentage = totalUsers > 0 ? (role.Value * 100 / totalUsers) : 0;
                            <tr>
                                <td>
                                    <i class="fas @(role.Key == "Lecturer" ? "fa-chalkboard-teacher" :
                                                                                         role.Key == "Coordinator" ? "fa-tasks" :
                                                                                         role.Key == "Manager" ? "fa-user-tie" :
                                                                                         role.Key == "HR" ? "fa-users-cog" : "fa-user") me-2"></i>
                            @role.Key
                        </td>
                        <td>@role.Value</td>
                        <td>@percentage%</td>
                    </tr>
                                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="chart-placeholder">
                    <i class="fas fa-chart-pie fa-3x mb-3"></i>
                    <p>No user role data available</p>
                </div>
            }
        </div>

        <!-- Claims by Department -->
        <div class="chart-container">
            <h4 class="chart-title"><i class="fas fa-building me-2"></i>Claims by Department</h4>
            @if (overview.ContainsKey("ClaimsByDepartment"))
            {
                var claimsByDept = overview["ClaimsByDepartment"] as Dictionary<string, int>;
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Claims</th>
                            <th>Percentage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var totalClaims = claimsByDept.Values.Sum();
                        }
                        @foreach (var dept in claimsByDept.OrderByDescending(x => x.Value))
                        {
                            var percentage = totalClaims > 0 ? (dept.Value * 100 / totalClaims) : 0;
                            <tr>
                                <td>@dept.Key</td>
                                <td>@dept.Value</td>
                                <td>@percentage%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="chart-placeholder">
                    <i class="fas fa-chart-bar fa-3x mb-3"></i>
                    <p>No department data available</p>
                </div>
            }
        </div>

        <!-- Claims Status Distribution -->
        <div class="chart-container">
            <h4 class="chart-title"><i class="fas fa-chart-pie me-2"></i>Claims Status Distribution</h4>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Count</th>
                        <th>Percentage</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var approvedCount = overview.ContainsKey("ApprovedClaims") ? (int)overview["ApprovedClaims"] : 0;
                        var pendingCount = overview.ContainsKey("PendingClaims") ? (int)overview["PendingClaims"] : 0;
                        var rejectedCount = overview.ContainsKey("RejectedClaims") ? (int)overview["RejectedClaims"] : 0;
                        var totalStatusClaims = approvedCount + pendingCount + rejectedCount;
                    }
                    <tr>
                        <td><span class="text-success"><i class="fas fa-check-circle me-2"></i>Approved</span></td>
                        <td>@approvedCount</td>
                        <td>@(totalStatusClaims > 0 ? (approvedCount * 100 / totalStatusClaims) : 0)%</td>
                    </tr>
                    <tr>
                        <td><span class="text-warning"><i class="fas fa-clock me-2"></i>Pending</span></td>
                        <td>@pendingCount</td>
                        <td>@(totalStatusClaims > 0 ? (pendingCount * 100 / totalStatusClaims) : 0)%</td>
                    </tr>
                    <tr>
                        <td><span class="text-danger"><i class="fas fa-times-circle me-2"></i>Rejected</span></td>
                        <td>@rejectedCount</td>
                        <td>@(totalStatusClaims > 0 ? (rejectedCount * 100 / totalStatusClaims) : 0)%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Monthly Breakdown -->
        <div class="chart-container">
            <h4 class="chart-title"><i class="fas fa-calendar me-2"></i>Monthly Activity</h4>
            @if (overview.ContainsKey("MonthlyBreakdown"))
            {
                var monthlyBreakdown = overview["MonthlyBreakdown"] as Dictionary<string, int>;
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Claims</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var month in monthlyBreakdown.OrderByDescending(x => x.Value))
                        {
                            <tr>
                                <td>@month.Key</td>
                                <td>@month.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="chart-placeholder">
                    <i class="fas fa-calendar-alt fa-3x mb-3"></i>
                    <p>No monthly data available</p>
                </div>
            }
        </div>
    </div>

    <!-- Top Performing Lecturers -->
    @if (overview.ContainsKey("TopLecturers"))
    {
        <div class="top-lecturers">
            <h4 class="section-title"><i class="fas fa-trophy me-2"></i>Top Performing Lecturers</h4>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Lecturer</th>
                        <th>Total Hours</th>
                        <th>Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var topLecturers = (overview["TopLecturers"] as IEnumerable<dynamic>)?.ToList();
                        var rank = 1;
                    }
                    @if (topLecturers != null)
                    {
                        @foreach (var lecturer in topLecturers)
                        {
                            <tr>
                                <td>
                                    @if (rank == 1)
                                    {
                                        <span class="text-warning"><i class="fas fa-crown"></i></span>
                                    }
                                    else
                                    {
                                        @rank
                                    }
                                </td>
                                <td>@lecturer.Lecturer</td>
                                <td>@lecturer.TotalHours hrs</td>
                                <td class="amount">R@(lecturer.TotalAmount.ToString("N0"))</td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- System Information -->
    <div class="system-info">
        <h4 class="section-title"><i class="fas fa-info-circle me-2"></i>System Information & Performance</h4>
        <div class="info-grid">
            <div>
                <div class="info-item">
                    <span class="info-label">Last Updated</span>
                    <span class="info-value">@DateTime.Now.ToString("MMMM dd, yyyy HH:mm")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Total Active Users</span>
                    <span class="info-value">@(overview.ContainsKey("ActiveUsers") ? overview["ActiveUsers"] : 0)</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Average Claim Amount</span>
                    <span class="info-value">R@(overview.ContainsKey("AverageClaimAmount") ? ((decimal)overview["AverageClaimAmount"]).ToString("N2") : "0.00")</span>
                </div>
            </div>
            <div>
                <div class="info-item">
                    <span class="info-label">Approved Claims</span>
                    <span class="info-value text-success">@(overview.ContainsKey("ApprovedClaims") ? overview["ApprovedClaims"] : 0)</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Rejected Claims</span>
                    <span class="info-value text-danger">@(overview.ContainsKey("RejectedClaims") ? overview["RejectedClaims"] : 0)</span>
                </div>
                <div class="info-item">
                    <span class="info-label">System Status</span>
                    <span class="status-badge status-operational">Operational</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('System Overview page loaded successfully');

            // Add some interactivity to the stats cards
            const statCards = document.querySelectorAll('.stat-card');
            statCards.forEach(card => {
                card.addEventListener('click', function() {
                    this.style.transform = 'translateY(-8px)';
                    setTimeout(() => {
                        this.style.transform = 'translateY(-5px)';
                    }, 150);
                });
            });

            // Auto-refresh data every 5 minutes
            setInterval(() => {
                console.log('Auto-refreshing system overview data...');
                // In a real application, you might want to reload the page or fetch fresh data via AJAX
            }, 300000); // 5 minutes
        });
    </script>
}