@model List<The_CMCS.Models.User>
@{
    ViewData["Title"] = "HR Dashboard";
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalLecturers = ViewBag.TotalLecturers ?? 0;
    var totalCoordinators = ViewBag.TotalCoordinators ?? 0;
    var totalManagers = ViewBag.TotalManagers ?? 0;
    var totalClaims = ViewBag.TotalClaims ?? 0;
    var approvedClaims = ViewBag.ApprovedClaims ?? 0;
    var pendingClaims = ViewBag.PendingClaims ?? 0;
    var totalAmount = ViewBag.TotalAmount ?? 0;
}

<div class="dashboard-header">
    <div class="header-content">
        <div class="welcome-section">
            <h1>HR Management Dashboard</h1>
            <p class="text-muted">Complete system administration and user management</p>
        </div>
        <span class="badge bg-success role-badge">HR Manager</span>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card users">
        <div class="stat-icon">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-content">
            <h3>@totalUsers</h3>
            <p>TOTAL USERS</p>
            <div class="stat-breakdown">
                <small>@totalLecturers Lecturers</small>
                <small>@totalCoordinators Coordinators</small>
                <small>@totalManagers Managers</small>
            </div>
        </div>
    </div>

    <div class="stat-card claims">
        <div class="stat-icon">
            <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <div class="stat-content">
            <h3>@totalClaims</h3>
            <p>TOTAL CLAIMS</p>
            <div class="stat-breakdown">
                <small>@approvedClaims Approved</small>
                <small>@pendingClaims Pending</small>
            </div>
        </div>
    </div>

    <div class="stat-card revenue">
        <div class="stat-icon">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="stat-content">
            <h3>R@(totalAmount.ToString("N0"))</h3>
            <p>TOTAL PAYOUTS</p>
            <div class="stat-trend">
                <i class="fas fa-chart-line text-success me-1"></i>
                <span class="text-success">Approved Claims</span>
            </div>
        </div>
    </div>

    <div class="stat-card system">
        <div class="stat-icon">
            <i class="fas fa-cogs"></i>
        </div>
        <div class="stat-content">
            <h3>100%</h3>
            <p>SYSTEM STATUS</p>
            <div class="stat-trend">
                <i class="fas fa-check-circle text-success me-1"></i>
                <span class="text-success">Operational</span>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-actions">
    <div class="action-grid">
        <a asp-action="ManageUsers" asp-controller="HR" class="action-card">
            <div class="action-icon">
                <i class="fas fa-user-plus"></i>
            </div>
            <div class="action-content">
                <h4>Manage Users</h4>
                <p>Create, edit, and manage system users</p>
            </div>
        </a>

        <a asp-action="Reports" asp-controller="HR" class="action-card">
            <div class="action-icon">
                <i class="fas fa-chart-bar"></i>
            </div>
            <div class="action-content">
                <h4>Reports & Invoices</h4>
                <p>Generate reports and download invoices</p>
            </div>
        </a>

        <a asp-action="SystemOverview" asp-controller="HR" class="action-card">
            <div class="action-icon">
                <i class="fas fa-tachometer-alt"></i>
            </div>
            <div class="action-content">
                <h4>System Overview</h4>
                <p>View comprehensive system analytics</p>
            </div>
        </a>

        <a asp-action="BulkInvoices" asp-controller="HR" class="action-card">
            <div class="action-icon">
                <i class="fas fa-download"></i>
            </div>
            <div class="action-content">
                <h4>Bulk Invoices</h4>
                <p>Download multiple invoices at once</p>
            </div>
        </a>
    </div>
</div>

<div class="recent-users-section">
    <div class="section-header">
        <h3><i class="fas fa-clock me-2"></i>Recently Added Users</h3>
        <a asp-action="ManageUsers" asp-controller="HR" class="view-all-link">
            View All <i class="fas fa-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Hourly Rate</th>
                    <th>Status</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.OrderByDescending(u => u.CreatedDate).Take(5))
                {
                    <tr>
                        <td>
                            <div class="user-info">
                                <i class="fas fa-user-circle me-2"></i>
                                @user.Name
                            </div>
                        </td>
                        <td>@user.Username</td>
                        <td>
                            <span class="role-badge role-@user.Role.ToLower()">
                                @user.Role
                            </span>
                        </td>
                        <td>@user.Department</td>
                        <td>
                            @if (user.Role == "Lecturer")
                            {
                                <span class="rate">R@(user.HourlyRate)</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="status-badge status-@(user.IsActive ? "active" : "inactive")">
                                <i class="fas fa-circle me-1"></i>
                                @(user.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <small class="text-muted">@user.CreatedDate.ToString("MMM dd, yyyy")</small>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .dashboard-header {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .welcome-section h1 {
            margin: 0;
            font-size: 2.5rem;
            font-weight: 700;
        }

        .welcome-section p {
            margin: 5px 0 0 0;
            opacity: 0.9;
            font-size: 1.1rem;
        }

        .role-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            display: flex;
            align-items: center;
            gap: 20px;
            transition: transform 0.3s, box-shadow 0.3s;
            border-left: 4px solid;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            }

            .stat-card.users {
                border-left-color: #3498db;
            }

            .stat-card.claims {
                border-left-color: #e74c3c;
            }

            .stat-card.revenue {
                border-left-color: #27ae60;
            }

            .stat-card.system {
                border-left-color: #9b59b6;
            }

        .stat-icon {
            width: 70px;
            height: 70px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
        }

        .stat-card.users .stat-icon {
            background: linear-gradient(135deg, #3498db, #2980b9);
        }

        .stat-card.claims .stat-icon {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
        }

        .stat-card.revenue .stat-icon {
            background: linear-gradient(135deg, #27ae60, #2ecc71);
        }

        .stat-card.system .stat-icon {
            background: linear-gradient(135deg, #9b59b6, #8e44ad);
        }

        .stat-content h3 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
        }

        .stat-content p {
            margin: 5px 0;
            color: #6c757d;
            font-weight: 500;
        }

        .stat-breakdown {
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin-top: 8px;
        }

            .stat-breakdown small {
                color: #6c757d;
                font-size: 0.8rem;
            }

        .stat-trend {
            display: flex;
            align-items: center;
            font-size: 0.8rem;
            margin-top: 5px;
        }

        .dashboard-actions {
            margin-bottom: 40px;
        }

        .action-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .action-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 20px;
            border: 2px solid transparent;
        }

            .action-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.15);
                border-color: #3498db;
                color: inherit;
            }

        .action-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #3498db, #2980b9);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .action-content h4 {
            margin: 0 0 8px 0;
            color: #2c3e50;
            font-weight: 600;
        }

        .action-content p {
            margin: 0;
            color: #6c757d;
            font-size: 0.9rem;
        }

        .recent-users-section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #f8f9fa;
        }

            .section-header h3 {
                margin: 0;
                color: #2c3e50;
                font-weight: 600;
            }

        .view-all-link {
            color: #3498db;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }

            .view-all-link:hover {
                color: #2980b9;
            }

        .dashboard-table {
            width: 100%;
            border-collapse: collapse;
        }

            .dashboard-table th {
                background: #f8f9fa;
                padding: 15px 12px;
                text-align: left;
                font-weight: 600;
                color: #495057;
                border-bottom: 2px solid #e9ecef;
            }

            .dashboard-table td {
                padding: 15px 12px;
                border-bottom: 1px solid #e9ecef;
                vertical-align: middle;
            }

            .dashboard-table tbody tr {
                transition: background-color 0.3s;
            }

                .dashboard-table tbody tr:hover {
                    background-color: #f8f9fa;
                }

        .user-info {
            display: flex;
            align-items: center;
            font-weight: 500;
            color: #2c3e50;
        }

        .role-badge {
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .role-hr {
            background-color: #d1edff;
            color: #0c5460;
        }

        .role-lecturer {
            background-color: #e3f2fd;
            color: #1976d2;
        }

        .role-coordinator {
            background-color: #fff3cd;
            color: #856404;
        }

        .role-manager {
            background-color: #f8d7da;
            color: #721c24;
        }

        .rate {
            font-weight: 600;
            color: #27ae60;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
        }

        .status-active {
            background-color: #d1edff;
            color: #0c5460;
        }

        .status-inactive {
            background-color: #f8d7da;
            color: #721c24;
        }

        .status-active .fa-circle {
            color: #27ae60;
            font-size: 0.6rem;
        }

        .status-inactive .fa-circle {
            color: #e74c3c;
            font-size: 0.6rem;
        }

        @@media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .action-grid {
                grid-template-columns: 1fr;
            }

            .section-header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
        }
    </style>
}