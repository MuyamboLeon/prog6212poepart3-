@model List<The_CMCS.Models.Claim>
@{
    ViewData["Title"] = "Reports & Invoices";
    var approvedClaims = Model ?? new List<The_CMCS.Models.Claim>();
    var totalApprovedClaims = ViewBag.TotalApprovedClaims ?? 0;
    var totalAmount = ViewBag.TotalAmount ?? 0;
    var departments = ViewBag.Departments as List<string> ?? new List<string>();
    var months = ViewBag.Months as List<string> ?? new List<string>();
    var currentYear = DateTime.Now.Year;
}

<style>
    .page-header {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
        padding: 30px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .title-section h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: 700;
    }

    .title-section p {
        margin: 5px 0 0 0;
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .header-actions {
        display: flex;
        gap: 15px;
    }

    .reports-container {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    .report-types {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .report-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 25px;
        border-left: 4px solid #3498db;
    }

        .report-card h4 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-weight: 600;
        }

    .report-form {
        display: flex;
        gap: 10px;
        align-items: end;
    }

    .form-group {
        flex: 1;
    }

        .form-group label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 5px;
            display: block;
        }

    .form-control {
        width: 100%;
        padding: 8px 12px;
        border: 2px solid #e9ecef;
        border-radius: 6px;
        font-size: 14px;
    }

    .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary {
        background: linear-gradient(135deg, #3498db, #2980b9);
        color: white;
    }

    .btn-success {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .claims-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .claims-table th {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 15px 12px;
            text-align: left;
            font-weight: 600;
            color: #495057;
            border-bottom: 3px solid #dee2e6;
        }

        .claims-table td {
            padding: 15px 12px;
            border-bottom: 1px solid #e9ecef;
            vertical-align: middle;
        }

        .claims-table tbody tr {
            transition: background-color 0.3s;
        }

            .claims-table tbody tr:hover {
                background-color: #f8f9fa;
            }

    .claim-ref {
        display: flex;
        align-items: center;
        font-weight: 500;
        color: #2c3e50;
    }

    .lecturer-info {
        font-weight: 500;
        color: #2c3e50;
    }

    .department-tag {
        background: #e3f2fd;
        color: #1976d2;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 500;
    }

    .amount {
        font-weight: 700;
        color: #27ae60;
        font-size: 14px;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .btn-action {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.3s;
        border: none;
        font-size: 12px;
    }

        .btn-action.download {
            background: #3498db;
            color: white;
        }

        .btn-action.view {
            background: #f39c12;
            color: white;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

    .summary-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-item {
        background: white;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        border-left: 4px solid #3498db;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #6c757d;
        font-weight: 500;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6c757d;
    }

    .empty-icon {
        font-size: 64px;
        color: #bdc3c7;
        margin-bottom: 20px;
    }

    .alert {
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-success {
        background-color: #d1edff;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    @@media (max-width: 768px) {
        .header-content {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .report-form {
            flex-direction: column;
            align-items: stretch;
        }

        .action-buttons {
            justify-content: center;
        }
    }
</style>

<div class="page-header">
    <div class="header-content">
        <div class="title-section">
            <h1><i class="fas fa-chart-bar me-3"></i>Reports & Invoices</h1>
            <p class="text-muted">Generate comprehensive reports and download invoices</p>
        </div>
        <div class="header-actions">
            <a asp-controller="HR" asp-action="Dashboard" class="btn btn-outline-light">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
            <a asp-controller="HR" asp-action="BulkInvoices" class="btn btn-light">
                <i class="fas fa-download me-2"></i>Bulk Invoices
            </a>
        </div>
    </div>
</div>

<div class="reports-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <div class="summary-stats">
        <div class="stat-item">
            <div class="stat-number">@totalApprovedClaims</div>
            <div class="stat-label">Approved Claims</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">R@(totalAmount.ToString("N0"))</div>
            <div class="stat-label">Total Amount</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@departments.Count</div>
            <div class="stat-label">Departments</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@months.Count</div>
            <div class="stat-label">Active Months</div>
        </div>
    </div>

    <div class="report-types">
        <div class="report-card">
            <h4><i class="fas fa-calendar me-2"></i>Monthly Report</h4>
            <form method="post" asp-action="GenerateMonthlyReport" asp-controller="HR">
                <div class="report-form">
                    <div class="form-group">
                        <label for="month">Select Month</label>
                        <select class="form-control" id="month" name="month" required>
                            <option value="">Choose month...</option>
                            <option value="January">January</option>
                            <option value="February">February</option>
                            <option value="March">March</option>
                            <option value="April">April</option>
                            <option value="May">May</option>
                            <option value="June">June</option>
                            <option value="July">July</option>
                            <option value="August">August</option>
                            <option value="September">September</option>
                            <option value="October">October</option>
                            <option value="November">November</option>
                            <option value="December">December</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="year">Year</label>
                        <input type="number" class="form-control" id="year" name="year" value="@currentYear" min="2020" max="2030" required>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-download me-2"></i>Generate
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="report-card">
            <h4><i class="fas fa-building me-2"></i>Department Report</h4>
            <form method="post" asp-action="GenerateDepartmentReport" asp-controller="HR">
                <div class="report-form">
                    <div class="form-group">
                        <label for="department">Select Department</label>
                        <select class="form-control" id="department" name="department" required>
                            <option value="">Choose department...</option>
                            @foreach (var dept in departments)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-download me-2"></i>Generate
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="section-header">
        <h3><i class="fas fa-file-invoice-dollar me-2"></i>Approved Claims for Invoicing</h3>
        <small class="text-muted">@approvedClaims.Count claims ready for invoice generation</small>
    </div>

    @if (approvedClaims.Any())
    {
        <div class="table-responsive">
            <table class="claims-table">
                <thead>
                    <tr>
                        <th>Claim Reference</th>
                        <th>Lecturer</th>
                        <th>Department</th>
                        <th>Month</th>
                        <th>Hours</th>
                        <th>Amount</th>
                        <th>Approved Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var claim in approvedClaims.OrderByDescending(c => c.ReviewedDate))
                    {
                        <tr>
                            <td>
                                <div class="claim-ref">
                                    <i class="fas fa-file-invoice-dollar me-2"></i>
                                    @claim.Id
                                </div>
                            </td>
                            <td>
                                <div class="lecturer-info">@claim.LecturerName</div>
                            </td>
                            <td>
                                <span class="department-tag">@claim.Department</span>
                            </td>
                            <td>@claim.Month</td>
                            <td>
                                <span class="hours-badge">@claim.HoursWorked hrs</span>
                            </td>
                            <td>
                                <span class="amount">R@(claim.TotalAmount.ToString("N0"))</span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @claim.ReviewedDate?.ToString("MMM dd, yyyy")
                                </small>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-controller="HR" asp-action="DownloadInvoice" asp-route-claimId="@claim.Id" class="btn-action download" title="Download Invoice">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <a asp-controller="AcademicManagers" asp-action="ClaimDetails" asp-route-id="@claim.Id" class="btn-action view" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-file-invoice"></i>
            </div>
            <h4>No Approved Claims</h4>
            <p class="text-muted">There are no approved claims available for reporting and invoicing at the moment.</p>
            <p class="text-muted">Claims will appear here once they are approved by both coordinator and manager.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set current month as default
            const months = ['January', 'February', 'March', 'April', 'May', 'June',
                          'July', 'August', 'September', 'October', 'November', 'December'];
            const currentMonth = months[new Date().getMonth()];
            document.getElementById('month').value = currentMonth;

            // Add some interactivity
            const reportForms = document.querySelectorAll('.report-form');
            reportForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    const button = this.querySelector('button[type="submit"]');
                    const originalText = button.innerHTML;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating...';
                    button.disabled = true;

                    setTimeout(() => {
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }, 2000);
                });
            });

            console.log('Reports page loaded successfully');
        });
    </script>
}